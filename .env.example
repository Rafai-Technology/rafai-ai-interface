# Where the Rafai AI agent service lives.
#
# Leave BOTH unset for local development: the dev server proxies /api to
# http://localhost:3000 and the browser stays on one origin.
#
# VITE_ variables are inlined at BUILD time, not read at runtime. Changing the
# API a built bundle points at means rebuilding it.

# Frontend hosted separately from the service (Vercel, Netlify, S3, ...).
# The service must list this frontend's origin in CORS_ORIGINS.
# VITE_API_BASE_URL=https://agent.rafaitech.in

# Dev only: point the proxy somewhere other than localhost:3000.
# VITE_DEV_API_TARGET=http://192.168.1.20:3000
